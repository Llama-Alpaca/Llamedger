<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="14dp" android:paddingRight="14dp"
    android:paddingTop="10dp" android:paddingBottom="10dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/srcTime"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/text_sub" android:text="--:--" />
        <TextView android:id="@+id/srcPkg"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="13sp" android:textColor="@color/text"
            android:layout_marginLeft="10dp" android:layout_marginStart="10dp"
            android:maxLines="1" android:ellipsize="middle" android:text="—" />
        <TextView android:id="@+id/srcBadge"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="10sp" android:paddingLeft="6dp" android:paddingRight="6dp"
            android:paddingTop="2dp" android:paddingBottom="2dp"
            android:background="@drawable/bg_pill_green" android:textColor="@color/green"
            android:text="已识别" />
    </LinearLayout>

    <TextView android:id="@+id/srcTitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="@color/text_sub"
        android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end"
        android:text="—" />
</LinearLayout>
